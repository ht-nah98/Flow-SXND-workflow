# Copy to .env and adjust. start.sh reads it; relative paths are relative to this repo.

# Where runtime data lives: database, uploaded idea images, QC frames, logs (never committed).
FLOWKIT_DATA_DIR=../du-lieu
# Where every project's output goes: <project>_<id>/final.mp4, clips, assets.
FLOWKIT_OUTPUT_DIR=../phim

# Google Flow project the extension works in (from its URL: labs.google/fx/tools/flow/project/<id>).
FLOW_PROJECT_ID=
# The Chrome extension allowed to connect. Fixed by the "key" in backend/extension/manifest.json.
FK_EXTENSION_ID=neclhaioibipmpacbhbiaponiekddhnh
# Veo start+end chaining is not ported; fall back to plain image-to-video.
FLOW_ALLOW_DEGRADED=1

# Ports: backend API, extension WebSocket, canvas UI.
API_PORT=8110
WS_PORT=9233
CANVAS_PORT=5180

# Đạo diễn AI: model / effort theo vai trò (mặc định ở backend/agent/config.py, xem docs/thiet-ke/model-theo-vai-tro.md)
# DIRECTOR_ROLE_MODELS='{"dp": "opus"}'
# DIRECTOR_ROLE_EFFORT='{"writer": "max"}'
# DIRECTOR_ESCALATE_MODEL=opus
